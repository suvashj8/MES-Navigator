{
  "name": "mes-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-watch.mjs",
    "dev:stable": "node index.js",
    "seed": "node seed.js",
    "import:sheet3": "node scripts/import-product-master-sheet3.js",
    "import:sheet3:replace": "node scripts/import-product-master-sheet3.js --replace",
    "db:setup": "node db-setup.js",
    "db:restore": "node scripts/migrate-sqlite-to-postgres.js --sqlite-path ./mes.db.migrated.bak --keep-sqlite",
    "migrate:from-sqlite": "node scripts/migrate-sqlite-to-postgres.js",
    "migrate:from-sqlite:dry": "node scripts/migrate-sqlite-to-postgres.js --dry-run",
    "cleanup:legacy-sqlite": "node scripts/cleanup-legacy-sqlite.js",
    "migrate:staff-photos": "node scripts/migrate-staff-photos-to-disk.js",
    "sync:staff": "node scripts/sync-staff-from-excel.js",
    "sync:grading": "node scripts/sync-grading-from-excel.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nepali-date-converter": "^3.4.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "better-sqlite3": "^12.10.0"
  }
}
