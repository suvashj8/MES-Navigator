{
  "name": "mes-worker-grading",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,ui -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:ui": "npm run dev --prefix client",
    "dev:api": "npm run dev --prefix server",
    "seed": "npm run seed --prefix server",
    "db:setup": "npm run db:setup --prefix server",
    "migrate:from-sqlite": "npm run migrate:from-sqlite --prefix server",
    "build": "npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
