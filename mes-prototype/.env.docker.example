# Copy to .env.docker and adjust before: docker compose --env-file .env.docker up -d --build
# Dev DB-only mode (npm run db:docker) only needs the MES_DB_* lines — run npm run sync:dev-env first.

# Host port for the web UI (nginx; /api proxied to mes-api internally)
MES_WEB_PORT=6001

# API container port (internal) and host port for direct curl/browser access
MES_API_PORT=6000
MES_API_HOST_PORT=6002

# PostgreSQL (mes-postgres service + mes-api DATABASE_URL)
MES_DB_USER=postgres
MES_DB_PASSWORD=mes_dev_123
MES_DB_NAME=mes_prototype
MES_DB_PORT=5432

# Required for API (min 32 chars; do not use placeholder secrets in production)
JWT_SECRET=mes-docker-local-dev-jwt-secret-min-32-chars

# Browser origins — UI on 6001; add 6002 if calling API directly from the browser
CORS_ORIGINS=http://localhost:6001,http://localhost:6002

# Seed Excel data on first start when users table is empty (set 0 to disable)
MES_AUTO_SEED=1
